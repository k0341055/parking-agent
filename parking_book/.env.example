# 複製此檔到 repo 根目錄的 .env，填入真實值後本機測試用
# .env 已在 .gitignore 中，不會被上傳

LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
GMAIL_SENDER=your_email@gmail.com
GMAIL_PASSWORD=your_app_password_here

# Recipient_N 的聯絡方式：信箱、LINE User ID 擇一或用逗號一起填
RECIPIENT_1=your_email@gmail.com,U0123456789abcdef0123456789abcdef

# Booking_N 的預約資料（JSON）
BOOKING_1='{"name":"王小明","plate":"AA-1234"}'
